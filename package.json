{
  "name": "keystone-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Keystone platform — lets MCP-compatible agents create, grade, curate, and drive sprints on Keystone Documents. Cloudflare Worker + Google OAuth. Published as a portfolio reference.",
  "private": true,
  "author": "Carolyn Driscoll",
  "license": "UNLICENSED",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:student": "wrangler dev -c wrangler.student.jsonc",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.34.0",
    "hono": "^4.13.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
