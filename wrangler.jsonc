{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystone-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": ["BrainliftMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BrainliftMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "BRAINLIFT_MCP_OAUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "KEYSTONE_BASE_URL": "https://your-keystone-host.example.com"
  },
  "dev": {
    "port": 8787
  }
}
